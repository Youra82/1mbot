[Unit]
Description=1mbot - Upbit-Listing-Waechter (Dry-Run) / Recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/REPLACE_ME/botprojekte/1mbot
ExecStart=/home/REPLACE_ME/botprojekte/1mbot/.venv/bin/python3 run.py
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=append:/home/REPLACE_ME/botprojekte/1mbot/logs/service.log
StandardError=append:/home/REPLACE_ME/botprojekte/1mbot/logs/service.log

[Install]
WantedBy=multi-user.target
